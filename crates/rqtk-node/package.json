{
  "name": "@rqtk/client",
  "version": "1.2.0",
  "description": "Read rqtk requirements repositories from Node, Bun and Deno: requirements, needs, stakeholders, verification status and history.",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://rqtk.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wdoppenberg/rqtk.git",
    "directory": "crates/rqtk-node"
  },
  "keywords": ["requirements", "traceability", "verification"],
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./types": {
      "types": "./types.d.ts"
    }
  },
  "files": ["index.js", "index.d.ts", "types.d.ts", "native.cjs", "native.d.ts", "*.node"],
  "engines": {
    "node": ">=18"
  },
  "napi": {
    "binaryName": "rqtk",
    "packageName": "@rqtk/client",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --platform --js native.cjs --dts native.d.ts --release",
    "build:debug": "napi build --platform --js native.cjs --dts native.d.ts",
    "typecheck": "tsc -p tests/tsconfig.json",
    "test": "node --test tests/"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.9",
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
