import os
from typing import Callable, TypeVar

_F = TypeVar("_F", bound=Callable[..., object])

class verifies:
    """Link a test to a verification activity. Raises ValueError for an unknown activity ID.

    ``case`` links one case of a parametrized test, by its pytest id (``test_x[case]``).
    """

    def __init__(self, activity_id: str, *, case: str | None = None) -> None: ...
    def __call__(self, wraps: _F) -> _F: ...

def run_cli(argv: list[str]) -> int:
    """Run the rqtk command line with argv (argv[0] is the program name); return the exit code."""

class Repository:
    """The native snapshot; use `rqtk.Repository`. Methods return the client's JSON."""

    def reload(self) -> Repository: ...
    def info(self) -> str: ...
    def requirements(self) -> str: ...
    def requirement(self, id: str) -> str | None: ...
    def find_requirements(self, filter: str) -> str: ...
    def needs(self) -> str: ...
    def need(self, id: str) -> str | None: ...
    def stakeholders(self) -> str: ...
    def stakeholder(self, id: str) -> str | None: ...
    def activities(self) -> str: ...
    def context(self, id: str) -> str: ...
    def trace(self, id: str) -> str: ...
    def coverage(self) -> str: ...
    def lint(self) -> str: ...
    def impact(self, base: str) -> str: ...
    def diff(self, from_ref: str, to_ref: str) -> str: ...
    def baselines(self) -> str: ...
    def history(self, id: str) -> str: ...

def open(path: str, reference: str | None = None) -> Repository: ...
def open_remote(url: str, reference: str, allow_file_url: bool = False) -> Repository: ...
def cache_dir() -> str | os.PathLike[str]: ...
def clear_cache() -> None: ...
