{
  "$defs": {
    "Category": {
      "oneOf": [
        {
          "const": "file",
          "description": "A file under `.rqtk/`.",
          "type": "string"
        },
        {
          "const": "document",
          "description": "A `--json` document a command prints.",
          "type": "string"
        },
        {
          "const": "client",
          "description": "A type the client libraries return or accept.",
          "type": "string"
        }
      ]
    },
    "SchemaKind": {
      "properties": {
        "category": {
          "$ref": "#/$defs/Category"
        },
