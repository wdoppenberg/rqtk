{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Requirement",
  "description": "One requirement file. Scalars sit at the top level; related groups are tables.",
  "type": "object",
  "properties": {
    "allocation": {
      "anyOf": [
        {
          "$ref": "#/$defs/Allocation"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/Approval"
        },
        {
          "type": "null"
        }
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "category": {
      "type": "string"
    },
    "content_hash": {
      "description": "Fingerprint of the semantic fields, see [`Requirement::compute_content_hash`].\nMaintained by `rqtk rehash`; checked by lint rule RQ021.",
      "type": [
        "string",
        "null"
      ]
    },
    "criticality": {
      "type": [
        "string",
        "null"
      ]
    },
    "custom": {
      "type": "object",
      "additionalProperties": true
    },
    "id": {
      "$ref": "#/$defs/RequirementId"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "maturity": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Parameter"
      }
    },
    "priority": {
      "type": "string"
    },
    "rationale": {
      "type": [
        "string",
        "null"
      ]
    },
    "risk": {
      "anyOf": [
        {
          "$ref": "#/$defs/Risk"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "type": "string"
    },
    "statement": {
      "description": "The normative statement, e.g. \"The system shall …\".",
      "type": "string"
    },
    "tbd": {
      "type": "boolean"
    },
    "tbr": {
      "type": "boolean"
    },
    "title": {
      "type": "string"
    },
    "trace": {
      "$ref": "#/$defs/Traceability"
    },
    "type": {
      "type": "string"
    },
    "validation": {
      "anyOf": [
        {
          "$ref": "#/$defs/ValidationSpec"
        },
        {
          "type": "null"
        }
      ]
    },
    "verification": {
      "$ref": "#/$defs/Verification"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "category",
    "type",
    "state",
    "priority",
    "statement",
    "verification"
  ],
  "$defs": {
    "Allocation": {
      "type": "object",
      "properties": {
        "components": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "software_modules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "subsystems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Approval": {
      "type": "object",
      "properties": {
        "approved_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "baselined_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "baselined_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "ecr_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "ExternalTrace": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "type": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "type",
        "ref"
      ]
    },
    "NeedId": {
      "description": "Identifier of a stakeholder need, e.g. `NEED-0001`.",
      "type": "string"
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "operator": {
          "type": "string"
        },
        "tolerance": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": true
      },
      "additionalProperties": false,
      "required": [
        "name",
        "operator",
        "value"
      ]
    },
    "RequirementId": {
      "description": "Identifier of a requirement, e.g. `FOBC-SYS-0001`.",
      "type": "string"
    },
    "Risk": {
      "type": "object",
      "properties": {
        "fmea_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "hazards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mitigations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "safety_critical": {
          "type": "boolean"
        },
        "security_sensitive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "StakeholderId": {
      "description": "Identifier of a stakeholder, e.g. `STK-001`.",
      "type": "string"
    },
    "Traceability": {
      "type": "object",
      "properties": {
        "conflicts_with": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementId"
          }
        },
        "depends_on": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementId"
          }
        },
        "derived_from": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementId"
          }
        },
        "external": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ExternalTrace"
          }
        },
        "parents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementId"
          }
        },
        "refines": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementId"
          }
        },
        "related": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequirementId"
          }
        },
        "satisfies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NeedId"
          }
        }
      },
      "additionalProperties": false
    },
    "ValidationSpec": {
      "type": "object",
      "properties": {
        "acceptance_criteria": {
          "type": [
            "string",
            "null"
          ]
        },
        "method": {
          "type": [
            "string",
            "null"
          ]
        },
        "stakeholder": {
          "anyOf": [
            {
              "$ref": "#/$defs/StakeholderId"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Verification": {
      "type": "object",
      "properties": {
        "activities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VerificationActivity"
          }
        },
        "level": {
          "type": "string"
        },
        "method": {
          "type": "string"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "phase": {
          "type": "string"
        },
        "success_criteria": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "method",
        "level",
        "phase"
      ]
    },
    "VerificationActivity": {
      "type": "object",
      "properties": {
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "executed_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "expected_result": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "procedure": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    }
  }
}
