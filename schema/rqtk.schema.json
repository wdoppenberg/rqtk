{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RqtkConfig",
  "type": "object",
  "properties": {
    "categories": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Category"
      }
    },
    "change_control": {
      "$ref": "#/$defs/ChangeControl"
    },
    "criticality": {
      "$ref": "#/$defs/CriticalityPolicy"
    },
    "export": {
      "$ref": "#/$defs/ExportConfig"
    },
    "identification": {
      "$ref": "#/$defs/IdentificationScheme"
    },
    "lifecycle": {
      "$ref": "#/$defs/LifecyclePolicy"
    },
    "priority": {
      "$ref": "#/$defs/PriorityPolicy"
    },
    "project": {
      "$ref": "#/$defs/ProjectMeta"
    },
    "repository": {
      "$ref": "#/$defs/RepositoryLayout",
      "default": {
        "required_dirs": [],
        "required_files": [],
        "requirements_dir": "requirements"
      }
    },
    "standards": {
      "type": "array",
      "default": [],
      "items": {
        "$ref": "#/$defs/Standard"
      }
    },
    "types": {
      "$ref": "#/$defs/TypePolicy"
    },
    "validation": {
      "$ref": "#/$defs/ValidationRules"
    },
    "verification": {
      "$ref": "#/$defs/VerificationPolicy"
    }
  },
  "required": [
    "project",
    "identification",
    "categories",
    "types",
    "verification",
    "lifecycle",
    "priority",
    "criticality",
    "change_control",
    "validation",
    "export"
  ],
  "$defs": {
    "Category": {
      "type": "object",
      "properties": {
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_root": {
          "description": "Marks this category as a traceability root (replaces the hard-coded \"STAKE\" sentinel).\nAt least one category should set this to `true` for orphan detection to work.",
          "type": "boolean",
          "default": false
        },
        "level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "level"
      ]
    },
    "ChangeControl": {
      "type": "object",
      "properties": {
        "approvers": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "ccb_required_after": {
          "type": "string"
        },
        "require_signoff": {
          "type": "boolean"
        }
      },
      "required": [
        "ccb_required_after",
        "require_signoff"
      ]
    },
    "CriticalityPolicy": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "levels"
      ]
    },
    "ExportConfig": {
      "type": "object",
      "properties": {
        "default_output_dir": {
          "type": [
            "string",
            "null"
          ]
        },
        "formats": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "IdentificationScheme": {
      "type": "object",
      "properties": {
        "id_pattern": {
          "type": "string"
        },
        "id_separator": {
          "type": "string",
          "default": "-"
        },
        "prefix": {
          "type": "string",
          "default": "REQ"
        },
        "zero_padding": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        }
      },
      "required": [
        "id_pattern"
      ]
    },
    "LifecyclePolicy": {
      "type": "object",
      "properties": {
        "default_state": {
          "type": "string"
        },
        "states": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "states",
        "default_state"
      ]
    },
    "PriorityPolicy": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "levels"
      ]
    },
    "ProjectMeta": {
      "type": "object",
      "properties": {
        "classification": {
          "type": [
            "string",
            "null"
          ]
        },
        "created": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "mission_phase": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "organization": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProjectOrganization"
            },
            {
              "type": "null"
            }
          ]
        },
        "risk_posture": {
          "type": [
            "string",
            "null"
          ]
        },
        "short_name": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "ProjectOrganization": {
      "type": "object",
      "properties": {
        "center": {
          "type": [
            "string",
            "null"
          ]
        },
        "cognizant_authority": {
          "type": [
            "string",
            "null"
          ]
        },
        "program": {
          "type": [
            "string",
            "null"
          ]
        },
        "responsible_engineer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "RepositoryLayout": {
      "type": "object",
      "properties": {
        "required_dirs": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "required_files": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "requirements_dir": {
          "type": "string",
          "default": "requirements"
        }
      }
    },
    "Standard": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title"
      ]
    },
    "TypePolicy": {
      "type": "object",
      "properties": {
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "allowed"
      ]
    },
    "ValidationRules": {
      "type": "object",
      "properties": {
        "allow_tbd": {
          "type": "boolean"
        },
        "allow_tbr": {
          "type": "boolean"
        },
        "forbid_circular_traces": {
          "type": "boolean"
        },
        "forbid_orphans": {
          "type": "boolean"
        },
        "forbidden_keywords": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "require_parent_for_levels": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "require_rationale": {
          "type": "boolean"
        },
        "require_verification_method": {
          "type": "boolean"
        },
        "shall_keywords": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "require_rationale",
        "require_verification_method",
        "forbid_orphans",
        "forbid_circular_traces",
        "allow_tbd",
        "allow_tbr"
      ]
    },
    "VerificationPolicy": {
      "type": "object",
      "properties": {
        "levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "methods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "phases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "methods",
        "levels",
        "phases"
      ]
    }
  }
}
