{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Stakeholder",
  "type": "object",
  "properties": {
    "authority": {
      "$ref": "#/$defs/StakeholderAuthority"
    },
    "concerns": {
      "$ref": "#/$defs/StakeholderConcerns"
    },
    "id": {
      "$ref": "#/$defs/StakeholderId"
    },
    "name": {
      "type": "string"
    },
    "organization": {
      "type": [
        "string",
        "null"
      ]
    },
    "role": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name"
  ],
  "$defs": {
    "StakeholderAuthority": {
      "type": "object",
      "properties": {
        "approval_scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "sign_off_required": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "StakeholderConcerns": {
      "type": "object",
      "properties": {
        "primary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "StakeholderId": {
      "description": "Identifier of a stakeholder, e.g. `STK-001`.",
      "type": "string"
    }
  }
}
